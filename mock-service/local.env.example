# Copy to local.env and fill in. local.env is gitignored and never committed.
#
#   cp mock-service/local.env.example mock-service/local.env
#
# Token needs Contents: read/write and Pull requests: read/write on the repos it will act on.
# Leave it blank to fall back to your git credential helper (clones work, opening PRs does not).
GITHUB_TOKEN=

# Shared secret the workflow must send as `Authorization: Bearer <token>`.
# Set this whenever the port is reachable from outside your machine (ngrok).
CONTRACT_SERVICE_TOKEN=

# "true" to actually open pull requests, anything else to only report findings.
OPEN_PR=true
